---
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100
# One-line bodies only for short methods defined inside a class, never for TESTs.
AllowShortFunctionsOnASingleLine: Inline
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(Eigen|nlohmann|gtest|gmock|benchmark|osqp)'
    Priority: 2
  - Regex: '^<'
    Priority: 1
  - Regex: '^"apex/'
    Priority: 3
  - Regex: '.*'
    Priority: 4
